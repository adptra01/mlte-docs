# Database Configuration (untuk deploy local / non-Docker)
DBDRIVER=mysql
MYSQLHOST=localhost
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=mlite
MYSQLPORT=3306

# Application Configuration
APPURL=http://localhost:8000/uploads
MULTIAPP=
MULTIAPP_REDIRECT=
DEVMODE=true

# ============================================
# Docker-specific variables (gunakan di docker/.env)
# ============================================
# DB_DRIVER=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_ROOT_PASSWORD=rootpassword123
# DB_DATABASE=mlite_db
# DB_USERNAME=mlite
# DB_PASSWORD=mlite
# REDIS_PASSWORD=mlite_redis_pass
# APP_PORT=8080
# DB_EXTERNAL_PORT=3308
# COMPOSE_PROFILES=mysql_enabled
